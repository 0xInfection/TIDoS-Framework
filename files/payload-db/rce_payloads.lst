# Separator templates for the rce module (files/payload-db/rce_payloads.lst).
# {cmd} is replaced by a command (echo of a computed value, or sleep N for the
# blind check). Templates are appended to the parameter's original value.
# Lines starting with "win:" are Windows cmd.exe templates.
;{cmd};
;{cmd}
|{cmd}
||{cmd}
&&{cmd}
&{cmd}&
%0a{cmd}%0a
$({cmd})
`{cmd}`
';{cmd};'
";{cmd};"
'$({cmd})'
"$({cmd})"
win:&{cmd}&
win:|{cmd}
win:||{cmd}
win:&&{cmd}
win:"&{cmd}&"
